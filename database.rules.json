{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": true,
      "$sala": {
        ".read": true,
        ".write": "$sala.matches(/^[A-Z]{4}$/)",
        "state": { ".validate": "newData.isString() && newData.val().length < 400000" },
        "public": { ".validate": "newData.isString() && newData.val().length < 400000" },
        "reloj": {
          ".validate": "newData.hasChildren(['paso'])",
          "paso": { ".validate": "newData.isString() && newData.val().length < 80" },
          "inicio": { ".validate": "newData.isNumber()" },
          "fin": { ".validate": "newData.isNumber()" },
          "restante": { ".validate": "newData.isNumber()" },
          "arrancado": { ".validate": "newData.isBoolean()" },
          "$otro": { ".validate": false }
        },
        "views": {
          "$id": { ".validate": "newData.isString() && newData.val().length < 200000" }
        },
        "avisos": {
          "$id": {
            ".validate": "newData.hasChildren(['texto'])",
            "texto": { ".validate": "newData.isString() && newData.val().length < 400" },
            "t": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": false }
          }
        },
        "actions": {
          "$accion": {
            ".validate": "newData.hasChildren(['type', 'id'])",
            "type": { ".validate": "newData.isString() && newData.val().length < 30" },
            "id": { ".validate": "newData.isString() && newData.val().length < 40" },
            "nombre": { ".validate": "newData.isString() && newData.val().length < 60" },
            "derechaId": { ".validate": "newData.isString() && newData.val().length < 40" },
            "paso": { ".validate": "newData.isString() && newData.val().length < 80" },
            "valor": { ".validate": "newData.isBoolean()" },
            "poder": { ".validate": "newData.isString() && newData.val().length < 40" },
            "eleccion": {
              ".validate": "(newData.isString() && newData.val().length < 100) || newData.isBoolean() || newData.isNumber() || newData.hasChildren()",
              "$k": { ".validate": "(newData.isString() && newData.val().length < 100) || newData.isBoolean() || newData.isNumber()" }
            },
            "t": { ".validate": "newData.isNumber()" },
            "$otro": { ".validate": false }
          }
        },
        "presencia": {
          "$jugador": { ".validate": "newData.isNumber()" }
        },
        "meta": {
          ".validate": "newData.hasChildren(['creada'])",
          "creada": { ".validate": "newData.isNumber()" },
          "$otro": { ".validate": false }
        },
        "$otro": { ".validate": false }
      }
    }
  }
}
